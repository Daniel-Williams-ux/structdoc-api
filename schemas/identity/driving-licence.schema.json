{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://structdoc.dev/schemas/identity/driving-licence.schema.json",
  "title": "driving licence",
  "description": "An identity document",
  "type": "object",
  "required": [
    "documentType",
    "fullName",
    "documentNumber",
    "confidenceScore",
    "contactInfo"
  ],
  "additionalProperties": false,
  "properties": {
    "documentType": { "type": "string", "const": "drivingLicence" },
    "fullName": { "type": "string", "minLength": 1 },
    "documentNumber": { "type": "string", "minLength": 1 },
    "confidenceScore": { "type": "number", "minimum": 0, "maximum": 1 },
    "contactInfo": {
      "type": "object",
      "required": ["address", "postcode"],
      "additionalProperties": false,
      "properties": {
        "address": { "type": "string", "minLength": 1 },
        "postcode": { "type": "string", "minLength": 1 }
      }
    },
    "expiryDate": {
      "type": ["string", "null"],
      "format": "date"
    }
  }
}